# local-runner 용 환경변수 예시 — 복사해서 .env.local 로 저장하고 값을 채우세요.
#   copy: (Windows CMD)  copy .env.local.example .env.local
# ⚠️ .env.local 은 절대 Git 에 커밋하지 마세요(.gitignore 로 차단됨).

# LS증권 Open API 앱키/시크릿 (발급 후 이메일로 수신)
LS_APP_KEY=
LS_APP_SECRET=

# 계좌 마스킹 표시용(선택). 미설정 시 API 응답의 계좌번호를 마스킹해 사용.
LS_ACCOUNT_NO=
LS_ACCOUNT_SUFFIX=

# 실주문 스위치 — 기본 observe-only. 실제 주문은 Phase 3 이후 + 이 값이 정확히 true 일 때만.
#   ⚠️ 현재 미체결 취소 TR(COSAT00311) 공식 필드가 미확인이라, true 로 바꿔도 실주문은 차단됩니다.
LS_LIVE_TRADING=false

# ARMED 모드 — 실주문 10개 필수조건 충족 여부만 감시(주문은 절대 내지 않음).
#   true 로 켜면 ls:usws 가 [ARMED]/[ARMED-READY] 로그를 남깁니다. 실주문과 무관.
LS_TRADING_ARMED=false

# ── Phase 3A 실전 제한(오늘) ──────────────────────────────────
LS_US_LIVE_SYMBOL=NASDAQ:AAPL   # 실전 대상 1종목만
LS_US_MAX_QTY=1                 # 최대 수량(코드에서 1로 상한 강제)
LS_US_DAILY_MAX_BUYS=1          # 하루 매수 최대 1회
LS_US_DAILY_MAX_SELLS=1         # 하루 매도 최대 1회
LS_US_PENDING_TIMEOUT_SEC=60    # 미체결 이 시간 경과 시 취소 시도

# HTS 교차검증(P0-16) — HTS 화면의 "타통화+원화 가능수량" 관찰값을 입력.
#   프로그램이 COSOQ02701 PrexchOrdAbleAmt/주문가 로 계산한 값과 반드시 일치해야 LIVE/주문 허용.
#   불일치 시 주문 차단(LIVE 금지). 미설정이면 비교 생략(프로그램 계산값만 로그 출력).
# LS_US_HTS_ORDERABLE_QTY=2

# 미체결 취소 TR(COSAT00311) 공식 필드 확인 스위치.
#   ⚠️ 코드 상수 LS_CANCEL_TR_CONFIRMED=false 가 최종 안전장치.
LS_CANCEL_TR_CONFIRMED=false

# 자동취소 모드 요청 스위치. 단, 코드상수(취소TR 공식필드)가 false 라 실제로는 항상 수동취소 모드로 동작.
#   수동취소 모드(기본): 미체결 시 자동취소하지 않고 "LS HTS/MTS에서 수동취소" 안내 → AS3 수신 시에만 다음 BUY.
LS_AUTO_CANCEL_MODE=false

# Phase 2 관찰 종목 (로컬 프로세스는 D1 미접근 → 여기서 지정). 미설정 시 기본값 사용.
#   국내: 종목코드 콤마구분    해외: 거래소:심볼 (거래소 생략 시 NASDAQ). 확인 거래소: NASDAQ, NYSE.
LS_KR_SYMBOLS=005930
LS_US_SYMBOLS=NASDAQ:AAPL,NASDAQ:TSLA

# ── 국내(KR) 실거래 설정 (ls:trade) — 실주문은 LS_LIVE_TRADING=true + 국내장 시간일 때만 ──
LS_KR_MAX_QTY=1              # 최대 수량(코드에서 1로 상한 강제)
LS_KR_DAILY_MAX_BUYS=1       # 하루 매수 최대 1회
# 회원(거래소 라우팅) 번호 — 공식 CSPAT00601 예제값 "NXT"(넥스트레이드). KRX 라우팅이 필요하면
# 실주문 전 올바른 값으로 반드시 확인/변경하세요. [KR-ORDER-PARAMS] 로그에 그대로 출력됩니다.
LS_KR_MBR_NO=NXT

# 미체결 주문을 이 시간(초) 경과 시 CSPAT00801 로 취소 시도(취소 접수 확인 후 다음 주문 허용).
LS_KR_PENDING_TIMEOUT_SEC=120
# 장 종료(15:30) 후 미체결이 모두 정리되면 러너를 종료할지. false 면 대기하며 다음 장 재개.
LS_KR_EXIT_AFTER_CLOSE=false

# 진단 원문 로그 — 기본 비활성. 필드 재확인이 필요할 때만 true.
LS_DIAG_RAW=false

# 해외 시세 구분 — 미국주식 실시간은 Non-Display 이용 불가 → 기본 DELAYED(지연).
#   LS_US_QUOTE_MODE=DELAYED | REALTIME  (기본 DELAYED)
#   REALTIME 은 delaygb='R'(공식 확인값). DELAYED 의 delaygb 코드는 추측하지 않으므로,
#   LS 공식 g3101/g3203 문서의 '지연' delaygb 값을 아래에 직접 입력해야 US 시세가 동작한다.
LS_US_QUOTE_MODE=DELAYED
LS_US_DELAYGB=

# 해외 API 약정등록 후 최초 1회: 기존(약정 전) 토큰 캐시를 삭제하고 새로 발급.
LS_FORCE_TOKEN_REFRESH=true

# 해외 실시간(WebSocket GSC/GSH) 관찰 러너(npm run ls:usws)는 이제 지속 실행형입니다.
# Ctrl+C(SIGINT) 전까지 계속 돌며 15분 확정봉을 local-runner/data/ 에 영구 저장/복원합니다.
# (LS_WS_SECONDS 는 더 이상 사용하지 않습니다.)
