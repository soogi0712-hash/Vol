# Vol 서버 시크릿/설정 템플릿 (P0-36) — 복사해서 secrets/vol.env 로 채운 뒤 사용.
#   cp secrets/vol.env.example secrets/vol.env   (그리고 실제 값 입력)
# ⚠️ secrets/vol.env 는 git/image 에 포함 금지(.gitignore·.dockerignore 처리됨). 서버 호스트에만 둔다.
# ⚠️ 아래 KEY/SECRET 는 예시 placeholder — 실제 LS 발급값으로 교체. 실제 값을 커밋/출력하지 말 것.

# ── LS Open API 자격증명(시크릿) ─────────────────────────
LS_APP_KEY=__REPLACE_WITH_LS_APP_KEY__
LS_APP_SECRET=__REPLACE_WITH_LS_APP_SECRET__
LS_ACCOUNT_NO=__REPLACE_WITH_ACCOUNT_NO__
LS_ACCOUNT_SUFFIX=__REPLACE_WITH_ACCOUNT_SUFFIX__

# ── 실거래 마스터 스위치 ─────────────────────────────────
LS_LIVE_TRADING=true
YEOKMAE_LIVE_TRADING=true
# 레거시 BB/RSI BUY 는 비활성 유지(설정하지 않음 = OFF)
# LEGACY_BB_LIVE_ENABLED=false

# ── KR (vol-kr) ─────────────────────────────────────────
YEOKMAE_KR_LIVE_TRADING=true
YEOKMAE_KR_EXIT_CONFIRMED=true
YEOKMAE_KR_STOP_LOSS_PCT=5
YEOKMAE_KR_TAKE_PROFIT_PCT=8
YEOKMAE_KR_MAX_HOLD_DAYS=20
YEOKMAE_KR_EMERGENCY_STOP_PCT=15
YEOKMAE_KR_TOTAL_CAPITAL_KRW=1000000
YEOKMAE_KR_PER_TRADE_KRW=100000
# LS_KR_MBR_NO=            # 미설정=NXT(문서 예제값). KRX 라우팅 필요 시 지정.

# ── US (vol-us) ─────────────────────────────────────────
YEOKMAE_US_LIVE_TRADING=true
YEOKMAE_US_EXIT_CONFIRMED=true
YEOKMAE_US_STOP_LOSS_PCT=5
YEOKMAE_US_TAKE_PROFIT_PCT=8
YEOKMAE_US_MAX_HOLD_DAYS=20
YEOKMAE_US_EMERGENCY_STOP_PCT=15
LS_US_TOTAL_CAPITAL_KRW=1000000
US_PER_TRADE_KRW=100000
# LS_US_QUOTE_MODE=DELAYED   # REALTIME 시세권한 있으면 REALTIME
# LS_US_DELAYGB=

# ── (P0-37/37A) 실보유 managed-position 복원 override ──────
#   과거 Vol 자동매수인데 원장에 없어 MANUAL_HOLDING 으로 잡힌 종목을 복원.
#   평단 우선순위(추측 금지): 실체결평단(계좌이벤트 AS1 avgExecPrc) > env override > broker 공식(KR t0424) > 주문가.
#   · KR 003120: t0424 공식평단 + pending 으로 자동 복원 — override 불필요.
#   · US AIOT/AMSF: __account_events__ 의 AS0/AS1 실체결(avgExecPrc/cumExecQty)로 평단·수량 자동 복원 — ENTRY_AVG override 불필요.
#   exchcd 는 US.symbol-exchcd.json(build-us-history 로 생성, g3190 공식 마스터)에서 자동 해결.
#   → 위 맵에 없거나 build 를 못 돌린 경우에만 아래 exchcd override 지정(NASDAQ=82, NYSE/AMEX=81):
# YEOKMAE_US_EXCHCD_AIOT=82
# YEOKMAE_US_EXCHCD_AMSF=81
#   (계좌이벤트/마스터가 없을 때의 최후 수동 주입 — 평단은 HTS 확인값으로만, 추측 금지):
# YEOKMAE_US_ENTRY_AVG_AIOT=2.9150
# YEOKMAE_US_ENTRY_AVG_AMSF=28.1200

# ── (선택) 루프 주기 튜닝 — 미설정 시 기본값 사용 ──────────
# KR_LOOP_SELL_MS=7000
# KR_LOOP_RECONCILE_MS=60000
# KR_LOOP_BUY_MS=1800000
# US_LOOP_SELL_MS=7000
# US_LOOP_RECONCILE_MS=60000
# US_LOOP_BUY_MS=1800000
