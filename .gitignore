# prod
dist/

# dev
.yarn/
!.yarn/releases
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# deps
node_modules/
.wrangler

# env — 비밀정보 (절대 커밋 금지)
.env
.env.*
!.env.local.example
.dev.vars
*.vars
secrets.json
*secret*
*credential*

# local-runner 캐시(토큰) — 커밋 금지 (로그는 아래 logs/ 규칙으로 무시됨)
local-runner/.cache/

# local-runner 15분봉 영구 저장 데이터 — 런타임 산출물, 커밋 금지(비밀값은 아니지만 사용자 데이터)
local-runner/data/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# P0-36 Docker 서버 상태(bind mount) — 런타임 산출물, 커밋 금지
state/

# P0-36 서버 시크릿 디렉터리 — 예시 템플릿만 커밋, 실제 값 파일(vol.env 등)은 금지
!secrets/
secrets/*
!secrets/vol.env.example

# misc
.DS_Store
